  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^12.5.0",
    "babel-preset-expo": "^56.0.15",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "react-test-renderer": "^19.2.3"
  }

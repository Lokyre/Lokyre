    ]
  },
  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^12.5.0",
    "babel-preset-expo": "^57.0.1",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.2.3"
  }

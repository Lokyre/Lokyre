{
  "name": "app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "^57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "^2.0.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-web": "^0.21.2",
    "uuid": "^14.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "private": true,
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-private-methods": "^8.0.1",
    "@babel/plugin-transform-private-property-in-object": "^8.0.5",
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^12.7.2",
    "babel-preset-expo": "^57.0.13",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "react-native-gesture-handler": "^3.3.0",
    "react-test-renderer": "^19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|uuid|react-native-safe-area-context|react-native-get-random-values)"
    ],
    "moduleNameMapper": {
      "react-native/setup-env": "<rootDir>/node_modules/@react-native/jest-preset/jest/setup.js"
    }
  }
}

{
  "name": "my-app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "^57.0.10",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/stack": "^7.10.22",
    "expo": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.9.0",
    "react-native-screens": "^4.27.0",
    "react-native-web": "^0.21.2",
    "uuid": "^14.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "^0.87.0",
    "@testing-library/react-native": "^12.5.0",
    "babel-preset-expo": "^57.0.7",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.2.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|react-navigation|@react-navigation/.*|@expo|expo-.*|uuid)/"
    ],
    "moduleNameMapper": {
      "^react-native/setup-env$": "<rootDir>/node_modules/@react-native/jest-preset/jest/setup.js"
    }
  }
}

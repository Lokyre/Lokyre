{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022",
      "DOM"
    ],
    "jsx": "react-native",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
